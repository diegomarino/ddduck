{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddduck.local/schemas/product/model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "purpose", "domains"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kind": { "const": "Model" },
    "id": { "type": "string", "pattern": "^model:[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "nameStatus": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "domains": { "type": "array", "items": { "type": "string", "pattern": "^domain:" }, "uniqueItems": true },
    "useCases": { "type": "array", "items": { "type": "string", "pattern": "^use-case:" }, "uniqueItems": true },
    "relationships": { "type": "array", "items": { "type": "string", "pattern": "^rel:" }, "uniqueItems": true },
    "decisions": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{3}$" }, "uniqueItems": true },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
